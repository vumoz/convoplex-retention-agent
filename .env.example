# Meta Model API key from https://dev.meta.ai
# Put the real key in your shell or a local .env that is NOT committed.
# This file is placeholders only.
META_API_KEY=

# Optional overrides. Defaults match the hackathon notes (Oct 2026).
META_BASE_URL=https://api.meta.ai/v1
META_CHAT_MODEL=muse-spark-1.3
META_IMAGE_MODEL=muse-image-1.0
META_ASR_MODEL=muse-voice-transcribe-1.0
# Muse Spark spends tokens on reasoning. Tool calls floor at 2500, and a
# finish_reason of length is retried once at double that budget.
META_MAX_TOKENS=2500

# auto | mock | live
# auto uses live when META_API_KEY is set, otherwise the deterministic mock.
CONVOPLEX_LLM=auto

CONVOPLEX_DB=data/convoplex.sqlite
CONVOPLEX_LOG=data/actions.jsonl

# WhatsApp Cloud API — later hackathon day. Placeholders only.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
